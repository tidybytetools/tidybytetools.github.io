{
  "openapi": "3.0.3",
  "info": {
    "title": "Tidy Byte Tools Apify API",
    "description": "Call public Tidy Byte Tools actors with the Apify run-sync API. POST the actor input as JSON. You need an Apify API token. See also https://mcp.apify.com/ and this site's /connect/ page. Actors whose public store page is not up yet are omitted here.",
    "version": "2026-11-10"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify API"
    }
  ],
  "paths": {
    "/acts/tidybytetools~pdf-table-pull/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_pdf_table_pull",
        "summary": "PDF Table Pull",
        "description": "PDF Table Pull: Pull tables out of PDFs into Excel, CSV, or JSON. Input: A PDF file or a link to a PDF. Output: Tables as Excel, CSV, or JSON. Numbers like (40) become -40. Price: $0.003 per pages with a table (Page with a table). Start fee $5e-05.",
        "tags": [
          "PDF Table Pull"
        ],
        "security": [
          {
            "ApifyToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items from a finished run.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
